# Copier ce fichier en .env puis remplir les valeurs.
# Le fichier .env ne doit JAMAIS être commité (il est dans .gitignore).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=supervision
DB_USER=supervision
DB_PASSWORD=mot_de_passe_de_la_base

# Clé secrète Flask : générer avec
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=a_remplacer

# 1 en développement, 0 en démonstration
FLASK_DEBUG=1
